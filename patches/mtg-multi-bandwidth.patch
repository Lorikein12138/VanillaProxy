diff --git a/mtglib/vanilla_bandwidth.go b/mtglib/vanilla_bandwidth.go
new file mode 100644
index 0000000000000000000000000000000000000000..5ae9df0e9a833cc36ada317ee6a749aa33dc456c
--- /dev/null
+++ b/mtglib/vanilla_bandwidth.go
@@ -0,0 +1,113 @@
+package mtglib
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"maps"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/mhsanaei/mtg-multi/essentials"
+	bandwidthipc "github.com/mhsanaei/mtg-multi/internal/vanillabandwidthipc"
+)
+
+var errBandwidthManagedSecrets = errors.New("VanillaProxy manages this secret configuration through process restarts")
+
+// BandwidthOptions binds authenticated secret names and signing keys to the
+// panel's client IDs.
+type BandwidthOptions struct {
+	gate           bandwidthipc.Gate
+	clients        map[string]string
+	policyBindings map[string]string
+}
+
+func NewBandwidthOptions(gate bandwidthipc.Gate, clients, policyBindings map[string]string) (*BandwidthOptions, error) {
+	if gate == nil || len(clients) == 0 || (policyBindings != nil && len(policyBindings) != len(clients)) {
+		return nil, errors.New("VanillaProxy bandwidth gate and client bindings are required")
+	}
+
+	for name, id := range clients {
+		if name == "" || !utf8.ValidString(name) || strings.IndexFunc(name, unicode.IsControl) >= 0 ||
+			(id == "" && policyBindings == nil) || len(id) > 256 || !utf8.ValidString(id) ||
+			strings.TrimSpace(id) != id || strings.IndexFunc(id, unicode.IsControl) >= 0 {
+			return nil, errors.New("invalid VanillaProxy bandwidth client binding")
+		}
+		if policyBindings != nil {
+			pin := policyBindings[name]
+			if _, err := hex.DecodeString(pin); err != nil || len(pin) != sha256.Size*2 || strings.ToLower(pin) != pin {
+				return nil, errors.New("invalid VanillaProxy bandwidth credential fingerprint")
+			}
+		}
+	}
+
+	return &BandwidthOptions{gate: gate, clients: maps.Clone(clients), policyBindings: maps.Clone(policyBindings)}, nil
+}
+
+func bandwidthCredentialFingerprint(key []byte) string {
+	digest := sha256.Sum256([]byte("mtproto\x00" + hex.EncodeToString(key)))
+	return hex.EncodeToString(digest[:])
+}
+
+func (b *BandwidthOptions) account(name string, key []byte) (string, bool) {
+	id, found := b.clients[name]
+	if b.policyBindings != nil {
+		found = found && len(key) == SecretKeyLength && b.policyBindings[name] == bandwidthCredentialFingerprint(key)
+	}
+	return id, found
+}
+
+// FakeTLS chooses the client name by signing key. Distinct hostnames do not
+// distinguish entries that share that key.
+func (b *BandwidthOptions) validateSecrets(secrets map[string]Secret) error {
+	if b == nil {
+		return nil
+	}
+
+	if len(b.clients) != len(secrets) {
+		return fmt.Errorf("%w: VanillaProxy bandwidth bindings differ from configured secrets", ErrSecretInvalid)
+	}
+	keys := make(map[[SecretKeyLength]byte]struct{}, len(secrets))
+	for name, secret := range secrets {
+		if _, allowed := b.account(name, secret.Key[:]); !allowed {
+			return fmt.Errorf("%w: VanillaProxy bandwidth credential binding differs from configured secret", ErrSecretInvalid)
+		}
+		if _, exists := keys[secret.Key]; exists {
+			return fmt.Errorf("%w: VanillaProxy bandwidth requires unique FakeTLS signing keys", ErrSecretInvalid)
+		}
+		keys[secret.Key] = struct{}{}
+	}
+
+	return nil
+}
+
+func (b *BandwidthOptions) wrap(ctx *streamContext, conn essentials.Conn, clientID string) essentials.Conn {
+	if clientID == "" {
+		return conn
+	}
+	return bandwidthConn{Conn: conn, ctx: ctx, gate: b.gate, clientID: clientID}
+}
+
+type bandwidthConn struct {
+	essentials.Conn
+	ctx      *streamContext
+	gate     bandwidthipc.Gate
+	clientID string
+}
+
+func (c bandwidthConn) Read(p []byte) (int, error) {
+	return c.Conn.Read(p[:min(len(p), bandwidthipc.MaxPermitBytes)])
+}
+
+func (c bandwidthConn) Write(p []byte) (int, error) {
+	if len(p) > 0 {
+		if err := c.gate(c.ctx, c.clientID, len(p)); err != nil {
+			c.ctx.ctxCancel()
+			return 0, err
+		}
+	}
+
+	return c.Conn.Write(p)
+}
