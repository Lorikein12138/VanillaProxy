index 0000000000000000000000000000000000000000..6d619b1010577bbe8c888a7c81aeaf46be1b3916
--- /dev/null
+++ b/mtglib/vanilla_bandwidth_test.go
@@ -0,0 +1,273 @@
+package mtglib
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/mhsanaei/mtg-multi/essentials"
+	bandwidthipc "github.com/mhsanaei/mtg-multi/internal/vanillabandwidthipc"
+	"github.com/mhsanaei/mtg-multi/mtglib/internal/relay"
+)
+
+func TestVanillaBandwidthRelay(t *testing.T) {
+	type request struct {
+		clientID string
+		size     int
+		result   chan error
+	}
+	requests := make(chan request)
+	server, err := bandwidthipc.Listen(func(ctx context.Context, clientID string, size int) error {
+		req := request{clientID: clientID, size: size, result: make(chan error, 1)}
+		select {
+		case requests <- req:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+		select {
+		case err := <-req.result:
+			return err
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+
+	gate, err := bandwidthipc.Dial(server.Info())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer gate.Close()
+
+	const secretName = "named-secret"
+	const clientID = "canonical-id"
+	options, err := NewBandwidthOptions(gate.Acquire, map[string]string{secretName: clientID}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	stream := &streamContext{ctx: ctx, ctxCancel: cancel, secretName: secretName}
+	telegram, upstream := net.Pipe()
+	defer telegram.Close()
+	client, downstream := net.Pipe()
+	defer client.Close()
+	deadline, _ := ctx.Deadline()
+	telegram.SetDeadline(deadline)
+	client.SetDeadline(deadline)
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		relay.Relay(stream, NoopLogger{},
+			options.wrap(stream, essentials.WrapNetConn(upstream), options.clients[stream.secretName]),
+			options.wrap(stream, essentials.WrapNetConn(downstream), options.clients[stream.secretName]),
+		)
+	}()
+
+	waitPermit := func(size int) request {
+		t.Helper()
+		select {
+		case req := <-requests:
+			if req.clientID != clientID || req.size != size {
+				t.Fatalf("permit for %q, %d bytes; want %q, %d bytes", req.clientID, req.size, clientID, size)
+			}
+			return req
+		case <-ctx.Done():
+			t.Fatal("relay did not request a permit")
+			return request{}
+		}
+	}
+
+	send := func(from, to net.Conn, data string, permitErr error) {
+		t.Helper()
+		writeErr := make(chan error, 1)
+		go func() {
+			_, err := io.WriteString(from, data)
+			writeErr <- err
+		}()
+		req := waitPermit(len(data))
+
+		// The payload has reached the relay, but the writer is still awaiting permission.
+		to.SetReadDeadline(time.Now().Add(20 * time.Millisecond))
+		buf := make([]byte, len(data))
+		n, err := to.Read(buf)
+		var netErr net.Error
+		if n != 0 || !errors.As(err, &netErr) || !netErr.Timeout() {
+			t.Fatalf("pre-permit read returned %d bytes, %v", n, err)
+		}
+		to.SetReadDeadline(deadline)
+		req.result <- permitErr
+		n, err = io.ReadFull(to, buf)
+		if permitErr != nil {
+			if n != 0 || !errors.Is(err, io.EOF) {
+				t.Fatalf("denied payload read returned %d bytes, %v", n, err)
+			}
+		} else if err != nil || string(buf) != data {
+			t.Fatalf("got %q, %v; want %q", buf, err, data)
+		}
+		if err := <-writeErr; err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	send(client, telegram, "upload", nil)
+	send(telegram, client, "download", nil)
+	send(client, telegram, "denied", errors.New("test permit denied"))
+
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("relay did not shut down on permit denial")
+	}
+}
