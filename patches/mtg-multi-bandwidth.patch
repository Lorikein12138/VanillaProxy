@@ -0,0 +1,51 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	bandwidthipc "github.com/mhsanaei/mtg-multi/internal/vanillabandwidthipc"
+	launch "github.com/mhsanaei/mtg-multi/internal/vanillalaunch"
+)
+
+func TestVanillaBandwidthBootstrap(t *testing.T) {
+	server, err := bandwidthipc.Listen(func(context.Context, string, int) error { return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+
+	data, err := json.Marshal(map[string]any{
+		"ipc":     server.Info(),
+		"clients": map[string]string{"named-secret": "canonical-id"},
+		"ready":   launch.Ready{Address: "127.0.0.1:12345", Nonce: make([]byte, launch.ReadyNonceSize)},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	options, client, ready, err := readBandwidthOptions(strings.NewReader(string(data)))
+	if err != nil || options == nil || client == nil || ready == nil || !ready.Valid() {
+		t.Fatalf("valid bootstrap returned options=%t client=%t err=%v", options != nil, client != nil, err)
+	}
+	client.Close()
+
+	for name, input := range map[string]string{
+		"absent":             "",
+		"missing capability": "{\"clients\":{}}",
+		"non-JSON trailer":   string(data) + "invalid",
+		"second object":      string(data) + "{}",
+		"oversized":          string(data) + strings.Repeat(" ", maxBandwidthBootstrapSize),
+		"invalid readiness":  strings.Replace(string(data), "127.0.0.1:12345", "192.0.2.1:12345", 1),
+		"invalid binding":    strings.Replace(string(data), "canonical-id", " canonical-id", 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			options, client, ready, err := readBandwidthOptions(strings.NewReader(input))
+			if err == nil || options != nil || client != nil || ready != nil {
+				t.Fatal("invalid bootstrap was accepted")
+			}
+		})
+	}
+}
