+func TestVanillaBandwidthAllowsOnlyExactPublishedCredential(t *testing.T) {
+	secret := Secret{Key: [SecretKeyLength]byte{15}, Host: "example.org"}
+	pin := bandwidthCredentialFingerprint(secret.Key[:])
+	gate := func(context.Context, string, int) error {
+		t.Fatal("an explicitly unmetered secret called the gate")
+		return nil
+	}
+	clients := map[string]string{"exempt": ""}
+	if _, err := NewBandwidthOptions(gate, clients, nil); err == nil {
+		t.Fatal("legacy bootstrap accepted an empty client ID")
+	}
+	options, err := NewBandwidthOptions(gate, clients, map[string]string{"exempt": pin})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := options.validateSecrets(map[string]Secret{"exempt": secret}); err != nil {
+		t.Fatal(err)
+	}
+	id, allowed := options.account("exempt", secret.Key[:])
+	if !allowed || id != "" {
+		t.Fatalf("account = %q, %t; want explicit unmetered", id, allowed)
+	}
+	var conn essentials.Conn
+	if wrapped := options.wrap(nil, conn, id); wrapped != conn {
+		t.Fatal("unmetered connection was wrapped")
+	}
+	if _, allowed := options.account("other", secret.Key[:]); allowed {
+		t.Fatal("matching key authorized a different name")
+	}
+	secret.Key[0]++
+	if _, allowed := options.account("exempt", secret.Key[:]); allowed {
+		t.Fatal("matching name authorized a different key")
+	}
+	if err := options.validateSecrets(map[string]Secret{"exempt": secret}); !errors.Is(err, ErrSecretInvalid) {
+		t.Fatalf("stale bootstrap returned %v; want ErrSecretInvalid", err)
+	}
+}
