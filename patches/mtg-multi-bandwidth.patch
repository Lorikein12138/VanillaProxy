+func TestVanillaBandwidthManagementFreezesSecretSet(t *testing.T) {
+	first := GenerateSecret("first.example.com")
+	second := GenerateSecret("second.example.com")
+	initial := map[string]Secret{"first": first, "second": second}
+	p := newReloadTestProxy(initial)
+	p.logger = NoopLogger{}
+	p.bandwidth = &BandwidthOptions{}
+	reloaderCalled := false
+	p.reloader = func() (SecretConfig, error) {
+		reloaderCalled = true
+		return SecretConfig{Secrets: initial}, nil
+	}
+	before := p.secrets.Load()
+	if err := p.ReloadSecrets(); !errors.Is(err, errBandwidthManagedSecrets) {
+		t.Fatalf("direct reload returned %v; want managed secret error", err)
+	}
+
+	requests := []struct {
+		method string
+		path   string
+		body   string
+		status int
+	}{
+		{http.MethodGet, "/stats", "", http.StatusOK},
+		{http.MethodGet, "/secrets", "", http.StatusOK},
+		{http.MethodGet, "/adtag", "", http.StatusOK},
+		{http.MethodPost, "/secrets/first/reset-quota", "", http.StatusOK},
+		{http.MethodPost, "/reload", "", http.StatusServiceUnavailable},
+		{http.MethodDelete, "/secrets/first", "", http.StatusConflict},
+		{http.MethodPost, "/secrets", fmt.Sprintf(`{"name":"added","secret":%q}`, second.Hex()), http.StatusConflict},
+		{http.MethodPut, "/secrets", fmt.Sprintf(`{"secrets":{"added":{"secret":%q}}}`, second.Hex()), http.StatusConflict},
+		{http.MethodPut, "/adtag", fmt.Sprintf(`{"ad_tag":%q}`, strings.Repeat("ab", AdTagLength)), http.StatusConflict},
+		{http.MethodDelete, "/adtag", "", http.StatusConflict},
+	}
+	request := func(handler http.Handler, method, path, body string) int {
+		t.Helper()
+		recorder := httptest.NewRecorder()
+		req := httptest.NewRequest(method, path, strings.NewReader(body))
+		handler.ServeHTTP(recorder, req)
+		return recorder.Code
+	}
+
+	handler := p.buildAPIHandler("")
+	for _, test := range requests {
+		status := request(handler, test.method, test.path, test.body)
+		if status != test.status {
+			t.Errorf("%s %s returned %d; want %d", test.method, test.path, status, test.status)
+		}
+	}
+	if reloaderCalled || p.secrets.Load() != before {
+		t.Fatal("managed API changed secret state or invoked the file reloader")
+	}
+
+	p.bandwidth = nil
+	handler = p.buildAPIHandler("")
+	for _, test := range requests {
+		status := request(handler, test.method, test.path, test.body)
+		if status != http.StatusOK {
+			t.Errorf("ordinary %s %s returned %d; want %d", test.method, test.path, status, http.StatusOK)
+		}
+	}
+	if !reloaderCalled || p.secrets.Load() == before {
+		t.Fatal("ordinary API failed to change secret state and invoke the file reloader")
+	}
+}
