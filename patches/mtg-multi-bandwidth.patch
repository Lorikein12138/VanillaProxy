+func TestVanillaBandwidthRejectsRepeatedSigningKeys(t *testing.T) {
+	first := GenerateSecret("first.example.com")
+	second := first
+	second.Host = "second.example.com"
+	duplicates := map[string]Secret{"first": first, "second": second}
+	distinct := map[string]Secret{"first": first, "second": GenerateSecret(first.Host)}
+	bandwidth, err := NewBandwidthOptions(func(context.Context, string, int) error { return nil },
+		map[string]string{"first": "id-1", "second": "id-2"}, nil,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	opts := ProxyOpts{
+		Secrets:         duplicates,
+		Network:         struct{ Network }{},
+		AntiReplayCache: struct{ AntiReplayCache }{},
+		IPBlocklist:     struct{ IPBlocklist }{},
+		IPAllowlist:     struct{ IPBlocklist }{},
+		EventStream:     &EventStreamMock{},
+		Logger:          NoopLogger{},
+	}
+	if err := opts.valid(); err != nil {
+		t.Fatalf("ordinary mode rejected valid secrets: %v", err)
+	}
+	opts.Bandwidth = bandwidth
+	if _, err := NewProxy(opts); !errors.Is(err, ErrSecretInvalid) {
+		t.Fatalf("managed startup returned %v; want ErrSecretInvalid", err)
+	}
+	opts.Secrets = distinct
+	if err := opts.valid(); err != nil {
+		t.Fatalf("managed mode rejected distinct keys for the same host: %v", err)
+	}
+}
