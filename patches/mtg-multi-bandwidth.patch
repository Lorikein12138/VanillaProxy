+++ b/internal/cli/vanilla_bandwidth.go
@@ -0,0 +1,51 @@
+package cli
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+
+	bandwidthipc "github.com/mhsanaei/mtg-multi/internal/vanillabandwidthipc"
+	launch "github.com/mhsanaei/mtg-multi/internal/vanillalaunch"
+	"github.com/mhsanaei/mtg-multi/mtglib"
+)
+
+const maxBandwidthBootstrapSize = 1 << 20
+
+func readBandwidthOptions(input io.Reader) (*mtglib.BandwidthOptions, *bandwidthipc.Client, *launch.Ready, error) {
+	var startup struct {
+		IPC            bandwidthipc.Info `json:"ipc"`
+		Clients        map[string]string `json:"clients"`
+		PolicyBindings map[string]string `json:"policy_bindings"`
+		Ready          launch.Ready      `json:"ready"`
+	}
+
+	data, err := io.ReadAll(io.LimitReader(input, maxBandwidthBootstrapSize+1))
+	if err != nil || len(data) > maxBandwidthBootstrapSize {
+		return nil, nil, nil, errors.New("cannot read VanillaProxy bandwidth bootstrap")
+	}
+
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&startup); err != nil || decoder.Decode(new(json.RawMessage)) != io.EOF {
+		return nil, nil, nil, errors.New("invalid VanillaProxy bandwidth bootstrap")
+	}
+
+	if !startup.Ready.Valid() {
+		return nil, nil, nil, errors.New("invalid VanillaProxy MTProto readiness challenge")
+	}
+
+	client, err := bandwidthipc.Dial(startup.IPC)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+
+	options, err := mtglib.NewBandwidthOptions(client.Acquire, startup.Clients, startup.PolicyBindings)
+	if err != nil {
+		client.Close()
+		return nil, nil, nil, err
+	}
+
+	return options, client, &startup.Ready, nil
+}
