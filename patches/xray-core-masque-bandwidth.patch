new file mode 100644
index 0000000..26da152
--- /dev/null
+++ b/proxy/masque/packet_gate.go
@@ -0,0 +1,52 @@
+package masque
+
+import "context"
+
+// packetGate is supplied by a dispatcher that meters authenticated CONNECT-IP
+// packets at the tunnel boundary.
+type packetGate interface {
+	VanillaProxyWaitMASQUEPacket(context.Context, int) error
+	// A managed identity returns a marked child context. An unmanaged identity
+	// returns the exact input. An invalid managed identity returns an error.
+	VanillaProxyMarkMASQUEFlow(context.Context) (context.Context, error)
+}
+
+// VanillaProxyPacketGateV1 identifies this revision of the packet boundary.
+func (*Server) VanillaProxyPacketGateV1() {}
+
+// VanillaProxyPacketGateEnabled reports whether this server has a packet gate.
+func (s *Server) VanillaProxyPacketGateEnabled() bool { return s.packetGate != nil }
+
+func (t *serverTunnel) enablePacketGate(ctx context.Context, requestDone, connectionDone <-chan struct{}, gate packetGate) {
+	t.gate = gate
+	t.gateCtx, t.cancelGate = context.WithCancel(ctx)
+	go func() {
+		select {
+		case <-requestDone:
+		case <-connectionDone:
+		case <-t.gateCtx.Done():
+		}
+		t.cancelGate()
+		// Unblock Read if the downlink stopped on an admission error.
+		t.conn.Close()
+	}()
+}
+
+func (t *serverTunnel) stopPacketGate() {
+	if t.cancelGate != nil {
+		t.cancelGate()
+	}
+}
+
+func (t *serverTunnel) waitPacket(n int) error {
+	if t.gate == nil {
+		return nil
+	}
+	if err := t.gateCtx.Err(); err != nil {
+		return err
+	}
+	if err := t.gate.VanillaProxyWaitMASQUEPacket(t.gateCtx, n); err != nil {
+		return err
+	}
+	return t.gateCtx.Err()
+}
