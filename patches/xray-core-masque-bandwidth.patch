@@ -0,0 +1,197 @@
+package masque
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport"
+)
+
+type packetGateFunc func(context.Context, int) error
+
+func (f packetGateFunc) VanillaProxyWaitMASQUEPacket(ctx context.Context, n int) error {
+	return f(ctx, n)
+}
+
+func (packetGateFunc) VanillaProxyMarkMASQUEFlow(ctx context.Context) (context.Context, error) {
+	return ctx, nil
+}
+
+func addMeteredTunnel(t *testing.T, s *Server, email string, reqDone, connDone <-chan struct{}) (*serverTunnel, *fakeTunnelConn) {
+	t.Helper()
+	user := &protocol.MemoryUser{Email: email, Account: &MemoryAccount{Password: "test"}}
+	conn := newFakeTunnelConn()
+	tunnel := newServerTunnel(conn, user)
+	tunnel.dev = &fakeDevice{reads: make(chan []byte, 16)}
+	for _, pool := range s.pools {
+		addr, ok := pool.allocate()
+		require.True(t, ok)
+		tunnel.addrs = append(tunnel.addrs, addr)
+	}
+	ctx := session.ContextWithInbound(t.Context(), &session.Inbound{Name: "masque", Tag: "test", User: user})
+	tunnel.enablePacketGate(ctx, reqDone, connDone, s.packetGate)
+	require.True(t, s.register(tunnel))
+	s.startTunnel(tunnel)
+	t.Cleanup(tunnel.close)
+	return tunnel, conn
+}
+
+func await[T any](t *testing.T, values <-chan T) T {
+	t.Helper()
+	select {
+	case value := <-values:
+		return value
+	case <-time.After(time.Second):
+		t.Fatal("timeout waiting for packet gate")
+		var zero T
+		return zero
+	}
+}
+
+func TestPacketGateMetersPrivateStackBeforePublication(t *testing.T) {
+	type charge struct {
+		email string
+		bytes int
+	}
+	charges := make(chan charge)
+	grants := make(chan struct{})
+	s, shared := newTestServer(t)
+	s.packetGate = packetGateFunc(func(ctx context.Context, n int) error {
+		select {
+		case charges <- charge{session.InboundFromContext(ctx).User.Email, n}:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+		select {
+		case <-grants:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	})
+	require.True(t, s.VanillaProxyPacketGateEnabled())
+	a, aConn := addMeteredTunnel(t, s, "alice", nil, nil)
+	_, bConn := addMeteredTunnel(t, s, "bob", nil, nil)
+	dev := a.dev.(*fakeDevice)
+	go s.readFromTunnel(a)
+	require.NoError(t, s.Start())
+	t.Cleanup(func() { _ = s.Close() })
+
+	// Neither an unassigned pool address nor another tenant is reachable.
+	aConn.reads <- ipPacket("10.14.0.2", "10.14.0.9")
+	aConn.reads <- ipPacket("10.14.0.2", "10.14.0.3")
+
+	toStack := ipPacket("fd14::2", "2001:db8::1")
+	aConn.reads <- toStack
+	require.Equal(t, charge{"alice", len(toStack)}, await(t, charges))
+	require.Empty(t, dev.packets())
+	grants <- struct{}{}
+	require.Eventually(t, func() bool { return len(dev.packets()) == 1 }, time.Second, time.Millisecond)
+	require.Equal(t, [][]byte{toStack}, dev.packets())
+	require.Empty(t, bConn.packets())
+	require.Empty(t, shared.packets())
+
+	// A private stack cannot send to the address assigned to another tunnel.
+	dev.reads <- ipPacket("2001:db8::1", "fd14::3")
+	fromStack := ipPacket("2001:db8::1", "fd14::2")
+	dev.reads <- fromStack
+	require.Equal(t, charge{"alice", len(fromStack)}, await(t, charges))
+	require.Empty(t, aConn.packets())
+	grants <- struct{}{}
+	require.Eventually(t, func() bool { return len(aConn.packets()) == 1 }, time.Second, time.Millisecond)
+	require.Equal(t, [][]byte{fromStack}, aConn.packets())
+}
+
+func TestPacketGateStopsWaitingOnRequestOrConnectionEnd(t *testing.T) {
+	for _, end := range []string{"request", "connection", "server", "user"} {
+		t.Run(end, func(t *testing.T) {
+			s, _ := newTestServer(t)
+			s.validator = newValidator()
+			requestDone, connDone := make(chan struct{}), make(chan struct{})
+			waiting, canceled := make(chan struct{}), make(chan error, 1)
+			s.packetGate = packetGateFunc(func(ctx context.Context, _ int) error {
+				close(waiting)
+				<-ctx.Done()
+				canceled <- ctx.Err()
+				return ctx.Err()
+			})
+			tunnel, conn := addMeteredTunnel(t, s, "alice", requestDone, connDone)
+			require.NoError(t, s.validator.add(tunnel.user))
+			require.NoError(t, s.Start())
+			t.Cleanup(func() { _ = s.Close() })
+			packet := ipPacket("192.0.2.1", "10.14.0.2")
+			require.Equal(t, tunnel, s.lookup(netip.MustParseAddr("10.14.0.2")))
+			tunnel.dev.(*fakeDevice).reads <- packet
+			await(t, waiting)
+			switch end {
+			case "request":
+				close(requestDone)
+			case "connection":
+				close(connDone)
+			case "server":
+				require.NoError(t, s.Close())
+			case "user":
+				require.NoError(t, s.RemoveUser(t.Context(), "alice"))
+			}
+			require.ErrorIs(t, await(t, canceled), context.Canceled)
+			require.Eventually(t, conn.isClosed, time.Second, time.Millisecond)
+			require.Empty(t, conn.packets())
+		})
+	}
+}
+
+type gateTestDispatcher struct {
+	routing.Dispatcher
+	emails []string
+}
+
+func (d *gateTestDispatcher) DispatchLink(ctx context.Context, _ net.Destination, _ *transport.Link) error {
+	d.emails = append(d.emails, session.InboundFromContext(ctx).User.Email)
+	return nil
+}
+
+type reuseStackConn struct{ stackConn }
+
+func (*reuseStackConn) RemoteAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IP{10, 14, 0, 2}, Port: 1234}
+}
+
+func TestPacketGateKeepsOldStackBoundAfterAddressReuse(t *testing.T) {
+	s, _ := newTestServer(t)
+	s.ctx = t.Context()
+	dispatcher := &gateTestDispatcher{}
+	s.dispatcher = dispatcher
+	s.packetGate = packetGateFunc(func(context.Context, int) error { return nil })
+	pool, err := newAddressPool(netip.MustParsePrefix("10.14.0.1/30"))
+	require.NoError(t, err)
+	s.pools = []*addressPool{pool}
+	alice, _ := addMeteredTunnel(t, s, "alice", nil, nil)
+	old := tunnelConnectionHandler{server: s, tunnel: alice}
+	dest := net.TCPDestination(net.ParseAddress("192.0.2.1"), 443)
+	old.HandleConnection(&reuseStackConn{}, dest)
+	require.Equal(t, []string{"alice"}, dispatcher.emails)
+
+	s.release(alice)
+	await(t, alice.stackDone)
+	await(t, alice.writerDone)
+	bob, bobConn := addMeteredTunnel(t, s, "bob", nil, nil)
+	require.Equal(t, alice.addrs, bob.addrs)
+
+	late := &reuseStackConn{}
+	old.HandleConnection(late, dest)
+	require.EqualValues(t, 1, late.closed.Load())
+	s.HandleConnection(&reuseStackConn{}, dest)
+	require.Equal(t, []string{"alice"}, dispatcher.emails)
+	require.Empty(t, bobConn.packets())
+
+	newHandler := tunnelConnectionHandler{server: s, tunnel: bob}
+	newHandler.HandleConnection(&reuseStackConn{}, dest)
+	require.Equal(t, []string{"alice", "bob"}, dispatcher.emails)
+}
