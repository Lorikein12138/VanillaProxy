+func (i *MultiUserInbound) decodeUDPPacket(packet []byte) (*ServerUDPSession, DecodedUDPPacket, error) {
+	const headerSize = 2 * AESBlockSize
+	if len(packet) < headerSize+1+8+2+AEADTagSize {
+		return nil, DecodedUDPPacket{}, ErrPacketTooShort
+	}
+	var header [AESBlockSize]byte
+	i.udpMasterCipher.Decrypt(header[:], packet[:AESBlockSize])
+
+	sessionID := binary.BigEndian.Uint64(header[:8])
+	packetID := binary.BigEndian.Uint64(header[8:])
+	if i.managedUDP.Load() {
+		hash := DecryptUDPEIH(i.udpMasterCipher, header[:], packet[AESBlockSize:headerSize])
+		return i.decodeManagedUDPPacket(hash, sessionID, packetID, header[:], packet[headerSize:])
+	}
+
+	s := i.udpSessions.GetOrCreate(sessionID)
+	s.Lock()
+	user := s.User
+	key := s.UserPSK
+	s.Unlock()
+	if user == nil {
+		hash := DecryptUDPEIH(i.udpMasterCipher, header[:], packet[AESBlockSize:headerSize])
+		var ok bool
+		user, ok = i.usersByHash.Load(hash)
+		if !ok {
+			return nil, DecodedUDPPacket{}, ErrInvalidRequest
+		}
+		key = user.Account.(*MemoryAccount).Key
+	}
+	decoded, err := s.DecryptAESPayload(i.method, key, sessionID, packetID, header[:], packet[headerSize:])
+	if err != nil {
+		return nil, DecodedUDPPacket{}, err
+	}
+	s.Lock()
+	if s.User == nil {
+		s.User = user
+		s.UserPSK = key
+	}
+	s.Unlock()
+	return s, decoded, nil
+}
+
+func (i *MultiUserInbound) decodeManagedUDPPacket(hash [AESBlockSize]byte, sessionID, packetID uint64, header, body []byte) (*ServerUDPSession, DecodedUDPPacket, error) {
+	user, ok := i.usersByHash.Load(hash)
+	if !ok {
+		return nil, DecodedUDPPacket{}, ErrInvalidRequest
+	}
+	psk := user.Account.(*MemoryAccount).Key
+	key := udpSessionKey{id: sessionID, user: user}
+	manager := i.udpSessions
+	if s, ok := manager.sessions.Load(key); ok {
+		decoded, err := s.DecryptAESPayload(i.method, psk, sessionID, packetID, header, body)
+		if err == nil {
+			manager.maybeCleanup(time.Now().Unix())
+		}
+		return s, decoded, err
+	}
+
+	// Publish only after authenticating the payload. A concurrent first
+	// packet can win publication, in which case its replay window is used.
+	candidate := &ServerUDPSession{
+		SessionID: sessionID,
+		User:      user,
+		UserPSK:   psk,
+		key:       key,
+		manager:   manager,
+	}
+	decoded, err := candidate.DecryptAESPayload(i.method, psk, sessionID, packetID, header, body)
+	if err != nil {
+		return nil, DecodedUDPPacket{}, err
+	}
+	i.Lock()
+	current, _ := i.usersByHash.Load(hash)
+	if current != user {
+		i.Unlock()
+		return nil, DecodedUDPPacket{}, ErrInvalidRequest
+	}
+	s, loaded := manager.sessions.LoadOrStore(key, candidate)
+	i.Unlock()
+	if loaded {
+		decoded, err = s.DecryptAESPayload(i.method, psk, sessionID, packetID, header, body)
+	}
+	manager.maybeCleanup(time.Now().Unix())
+	return s, decoded, err
+}
+
+func (i *MultiUserInbound) encodeUDPSessionReply(s *ServerUDPSession, dest net.Destination, payload []byte) ([]byte, error) {
+	s.Lock()
+	psk := s.UserPSK
+	s.Unlock()
+	if s.key.user == nil {
+		return i.udpSessions.EncodeServerPacket(i.method, psk, s.SessionID, dest, payload)
+	}
+	if s.closed.Load() {
+		return nil, ErrInvalidRequest
+	}
+	if err := s.EnsureServerState(i.method, psk); err != nil {
+		return nil, err
+	}
+	return s.EncodeServerPacket(i.method, s.SessionID, dest, payload)
 }
