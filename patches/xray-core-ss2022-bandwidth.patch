+func TestManagedUDPSessionExpiryPreservesReplacement(t *testing.T) {
+	manager := NewUDPSessionManager(time.Minute)
+	user := &protocol.MemoryUser{Email: "alice"}
+	key := udpSessionKey{id: 41, user: user}
+	old := &ServerUDPSession{key: key, manager: manager}
+	current := &ServerUDPSession{key: key, manager: manager}
+	current.LastActive.Store(100)
+	manager.sessions.Store(key, current)
+
+	manager.removeManagedSession(old, 50)
+	manager.removeManagedSession(current, 50)
+	got, ok := manager.sessions.Load(key)
+	if !ok || got != current || current.closed.Load() || !old.closed.Load() {
+		t.Fatal("expiring a stale session removed its active replacement")
+	}
+}
