+func TestManagedMultiUserUDPAuthenticatedSession(t *testing.T) {
+	ctx := context.Background()
+	method, err := GetCipherMethod(MethodAES128GCM)
+	if err != nil {
+		t.Fatal(err)
+	}
+	master := bytes.Repeat([]byte{1}, method.KeySaltLength)
+	block, err := method.NewBlock(master)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager := NewUDPSessionManager(time.Minute)
+	inbound := &MultiUserInbound{
+		method: method, udpMasterCipher: block, udpSessions: manager,
+		usersByHash:  utils.NewTypedSyncMap[[AESBlockSize]byte, *protocol.MemoryUser](),
+		usersByEmail: utils.NewTypedSyncMap[string, *protocol.MemoryUser](),
+	}
+	inbound.EnableManagedUDP()
+
+	dest := net.UDPDestination(net.LocalHostIP, 9999)
+	newClient := func(email string, keyByte byte) (*protocol.MemoryUser, *ClientUDPSession) {
+		t.Helper()
+		key := bytes.Repeat([]byte{keyByte}, method.KeySaltLength)
+		user := &protocol.MemoryUser{Email: email, Account: &MemoryAccount{Key: key}}
+		if err := inbound.AddUser(ctx, user); err != nil {
+			t.Fatal(err)
+		}
+		codec, err := NewUDPPacketCodec(method, [][]byte{master, key})
+		if err != nil {
+			t.Fatal(err)
+		}
+		client, err := codec.NewClientSession()
+		if err != nil {
+			t.Fatal(err)
+		}
+		return user, client
+	}
+	roundTrip := func(user *protocol.MemoryUser, client *ClientUDPSession) *ServerUDPSession {
+		t.Helper()
+		payload := []byte(user.Email)
+		packet, err := client.EncodePacket(dest, payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer packet.Release()
+		s, decoded, err := inbound.decodeUDPPacket(packet.Bytes())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if s.User != user || s.key != (udpSessionKey{id: client.ClientSessionID(), user: user}) || !bytes.Equal(decoded.Payload, payload) {
+			t.Fatal("request lost its authenticated session or payload")
+		}
+		reply, err := inbound.encodeUDPSessionReply(s, dest, payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		decoded, err = client.DecodePacket(reply)
+		if err != nil || !bytes.Equal(decoded.Payload, payload) {
+			t.Fatalf("reply did not use the same authenticated session: %v", err)
+		}
+		return s
+	}
+
+	a, clientA := newClient("alice", 2)
+	b, clientB := newClient("bob", 3)
+	sessionA := roundTrip(a, clientA)
+	sessionB := roundTrip(b, clientB)
+	if sessionA == sessionB || roundTrip(a, clientA) != sessionA || roundTrip(b, clientB) != sessionB {
+		t.Fatal("interleaved users did not retain independent sessions")
+	}
+	if err := inbound.RemoveUser(ctx, a.Email); err != nil {
+		t.Fatal(err)
+	}
+	if !sessionA.closed.Load() || sessionB.closed.Load() {
+		t.Fatal("credential removal did not close just the revoked credential's sessions")
+	}
+	replacement, clientR := newClient(a.Email, 2)
+	if s := roundTrip(replacement, clientR); s == sessionA || s.key.user != replacement {
+		t.Fatal("replacement credential inherited the removed user record")
+	}
+}
