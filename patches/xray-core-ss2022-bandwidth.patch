+func TestManagedUDPReplyRequiresCurrentLinkAndCredential(t *testing.T) {
+	ctx := context.Background()
+	policyManager, err := policyapp.New(ctx, &policyapp.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	dispatcher := managedUDPTestDispatcher{}
+	manager := NewUDPSessionManager(time.Minute)
+	user := &protocol.MemoryUser{Email: "alice"}
+	key := udpSessionKey{id: 1, user: user}
+	s := &ServerUDPSession{SessionID: key.id, key: key, User: user, manager: manager}
+	manager.sessions.Store(key, s)
+	t.Cleanup(s.Close)
+
+	dest := net.UDPDestination(net.LocalHostIP, 9999)
+	originalConn := &managedUDPTestConn{}
+	original, err := s.EnsureLink(ctx, originalConn, dest, dispatcher, policyManager, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.writeUDPResponse(original, []byte("first")); err != nil || originalConn.writes != 1 {
+		t.Fatalf("initial live link did not write: %v", err)
+	}
+
+	s.timer.SetTimeout(0)
+	replacementConn := &managedUDPTestConn{}
+	replacement, err := s.EnsureLink(ctx, replacementConn, dest, dispatcher, policyManager, nil)
+	if err != nil || replacement == original {
+		t.Fatalf("could not reopen routing link: %v", err)
+	}
+	if err := s.writeUDPResponse(original, []byte("stale")); err == nil || originalConn.writes != 1 || replacementConn.writes != 0 {
+		t.Fatal("a stale routing link wrote a packet after replacement")
+	}
+	if err := s.writeUDPResponse(replacement, []byte("second")); err != nil || replacementConn.writes != 1 {
+		t.Fatalf("replacement link did not write: %v", err)
+	}
+	manager.removeManagedUser(user)
+	if err := s.writeUDPResponse(replacement, []byte("revoked")); err == nil || replacementConn.writes != 1 {
+		t.Fatal("a removed credential wrote another packet")
+	}
+}
