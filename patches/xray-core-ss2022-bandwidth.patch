+func TestManagedUDPRoutingLinksCopyWorkerMetadata(t *testing.T) {
+	ctx := context.Background()
+	parentDest := net.UDPDestination(net.LocalHostIP, 10)
+	parentIn := &session.Inbound{Tag: "inbound"}
+	parentOut := []*session.Outbound{{Target: parentDest, Tag: "primary"}, {Tag: "secondary"}}
+	parentContent := &session.Content{
+		Protocol:        "original",
+		Attributes:      map[string]string{"inherited": "worker"},
+		SniffingRequest: session.SniffingRequest{OverrideDestinationForProtocol: []string{"http"}},
+	}
+	ctx = session.ContextWithInbound(ctx, parentIn)
+	ctx = session.ContextWithOutbounds(ctx, parentOut)
+	ctx = session.ContextWithContent(ctx, parentContent)
+	policyManager, err := policyapp.New(ctx, &policyapp.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var contexts []context.Context
+	dispatcher := managedUDPTestDispatcher{onDispatch: func(child context.Context, dst net.Destination) {
+		contexts = append(contexts, child)
+		inbound := session.InboundFromContext(child)
+		outbounds := session.OutboundsFromContext(child)
+		content := session.ContentFromContext(child)
+		if len(outbounds) != 2 || outbounds[0].Target != parentDest || outbounds[1].Tag != "secondary" ||
+			inbound.Tag != "inbound" || content.Attribute("inherited") != "worker" {
+			t.Fatal("a routing link did not inherit the worker metadata")
+		}
+		outbounds[0].Target = dst
+		outbounds[0].RouteTarget = dst
+		outbounds[1].Tag = inbound.User.Email
+		content.Protocol = inbound.User.Email
+		content.SetAttribute("session", inbound.User.Email)
+		content.SniffingRequest.OverrideDestinationForProtocol[0] = inbound.User.Email
+	}}
+	users := []*protocol.MemoryUser{{Email: "alice"}, {Email: "bob"}}
+	conn := &managedUDPTestConn{}
+	for idx, user := range users {
+		s := &ServerUDPSession{key: udpSessionKey{id: uint64(idx), user: user}, User: user}
+		if _, err := s.EnsureLink(ctx, conn, net.UDPDestination(net.LocalHostIP, net.Port(100+idx)), dispatcher, policyManager, nil); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(s.Close)
+	}
+	for idx, child := range contexts {
+		inbound := session.InboundFromContext(child)
+		outbounds := session.OutboundsFromContext(child)
+		content := session.ContentFromContext(child)
+		email := users[idx].Email
+		if inbound.User != users[idx] || outbounds[0].RouteTarget.Port != net.Port(100+idx) ||
+			outbounds[1].Tag != email || content.Protocol != email ||
+			content.Attribute("session") != email || content.SniffingRequest.OverrideDestinationForProtocol[0] != email {
+			t.Fatal("routing metadata changed when another session used the same worker")
+		}
+	}
+	if parentIn.User != nil || parentOut[0].Target != parentDest || parentOut[0].RouteTarget.IsValid() ||
+		parentOut[1].Tag != "secondary" || parentContent.Protocol != "original" ||
+		parentContent.Attribute("session") != "" || parentContent.SniffingRequest.OverrideDestinationForProtocol[0] != "http" {
+		t.Fatal("routing link modified the shared worker metadata")
+	}
+}
