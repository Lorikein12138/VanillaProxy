index 0000000..7453267
--- /dev/null
+++ b/proxy/wireguard/packet_gate_test.go
@@ -0,0 +1,215 @@
+package wireguard
+
+import (
+	"context"
+	"crypto/rand"
+	"fmt"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"github.com/xtls/xray-core/common/protocol"
+	"golang.org/x/crypto/curve25519"
+	"golang.zx2c4.com/wireguard/conn/bindtest"
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun/tuntest"
+)
+
+type wgTestGate func(context.Context, string, int) error
+
+func (g wgTestGate) VanillaProxyWaitWireGuardPacket(ctx context.Context, id string, n int) error {
+	return g(ctx, id, n)
+}
+
+func (wgTestGate) VanillaProxyWireGuardClients(context.Context, []*protocol.MemoryUser) (map[[32]byte]string, bool, error) {
+	return nil, false, nil
+}
+
+func (wgTestGate) VanillaProxyMarkWireGuardFlow(ctx context.Context) (context.Context, error) {
+	return ctx, nil
+}
+
+func wgTestUser(email string, key [32]byte, prefix string) *protocol.MemoryUser {
+	return &protocol.MemoryUser{
+		Email: email,
+		Account: &MemoryAccount{
+			Pub: key, AllowedIPs: []netip.Prefix{netip.MustParsePrefix(prefix)},
+		},
+	}
+}
+
+func TestWireGuardGatePolicyRejectsAmbiguityAndFreezesNativePeers(t *testing.T) {
+	a, b := [32]byte{1}, [32]byte{2}
+	alice := wgTestUser("alice", a, "10.0.0.2/32")
+	bob := wgTestUser("bob", b, "fd00::3/128")
+	ids := map[[32]byte]string{a: "shared", b: "shared"}
+	gate := wgTestGate(func(context.Context, string, int) error { return nil })
+	policy, err := newPacketGatePolicy(gate, [32]byte{9}, []*protocol.MemoryUser{alice, bob}, ids)
+	require.NoError(t, err)
+	s := &Server{packetPolicy: policy}
+	require.True(t, s.VanillaProxyWireGuardPacketGateEnabled())
+	require.Error(t, s.AddUser(t.Context(), wgTestUser("new", [32]byte{3}, "10.8.8.8/32")))
+	require.Error(t, s.RemoveUser(t.Context(), alice.Email))
+	first := policy.route(netip.MustParseAddr("10.0.0.2"))
+	second := policy.route(netip.MustParseAddr("fd00::3"))
+	require.Same(t, first.client, second.client)
+	require.Same(t, alice, s.GetUserByAddr(t.Context(), netip.MustParseAddr("::ffff:10.0.0.2")))
+	require.Same(t, bob, s.GetUserByAddr(t.Context(), netip.MustParseAddr("fd00::3")))
+	require.Nil(t, s.GetUserByAddr(t.Context(), netip.MustParseAddr("fd00::4")))
+
+	for _, peer := range []*protocol.MemoryUser{
+		wgTestUser("duplicate key", a, "10.1.0.0/16"),
+		wgTestUser("overlap", b, "10.0.0.31/24"),
+		wgTestUser("mapped IPv6", b, "::ffff:10.0.1.2/128"),
+		wgTestUser("unknown key", [32]byte{3}, "10.1.0.0/16"),
+	} {
+		t.Run(peer.Email, func(t *testing.T) {
+			_, err := newPacketGatePolicy(gate, [32]byte{9}, []*protocol.MemoryUser{alice, peer}, ids)
+			require.Error(t, err)
+		})
+	}
+}
+
+func wireGuardGateReceive[T any](t *testing.T, from <-chan T) T {
+	t.Helper()
+	select {
+	case value := <-from:
+		return value
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for WireGuard packet")
+		var zero T
+		return zero
+	}
+}
+
+func wireGuardGateSend(t *testing.T, to chan<- []byte, packet []byte) {
+	t.Helper()
+	select {
+	case to <- packet:
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out sending WireGuard packet")
+	}
+}
+
+func TestWireGuardGateEncryptedTransportBeforeAndAfterAdmission(t *testing.T) {
+	var serverKey, clientKey, serverPub, clientPub [32]byte
+	_, err := rand.Read(serverKey[:])
+	require.NoError(t, err)
+	_, err = rand.Read(clientKey[:])
+	require.NoError(t, err)
+	curve25519.ScalarBaseMult(&serverPub, &serverKey)
+	curve25519.ScalarBaseMult(&clientPub, &clientKey)
+	clientAddr := netip.MustParseAddr("10.0.0.2")
+	serverAddr := netip.MustParseAddr("10.0.0.1")
+	client := wgTestUser("peer", clientPub, "10.0.0.2/32")
+	other := wgTestUser("unused", [32]byte{3}, "10.0.0.3/32")
+	type admission struct {
+		id string
+		n  int
+	}
+	requests := make(chan admission, 2)
+	grants := make(chan struct{})
+	gate := wgTestGate(func(ctx context.Context, id string, n int) error {
+		select {
+		case requests <- admission{id, n}:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+		select {
+		case <-grants:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	})
+	policy, err := newPacketGatePolicy(gate, serverPub, []*protocol.MemoryUser{client, other}, map[[32]byte]string{clientPub: "account", {3}: "other"})
+	require.NoError(t, err)
+	serverTUN, clientTUN := tuntest.NewChannelTUN(), tuntest.NewChannelTUN()
+	binds := bindtest.NewChannelBinds()
+	server := device.NewDevice(newPacketGateTun(serverTUN.TUN(), policy), binds[0], device.NewLogger(device.LogLevelSilent, ""))
+	t.Cleanup(server.Close)
+	peer := device.NewDevice(clientTUN.TUN(), binds[1], device.NewLogger(device.LogLevelSilent, ""))
+	t.Cleanup(peer.Close)
+	require.NoError(t, server.IpcSet(fmt.Sprintf("private_key=%x\npublic_key=%x\nallowed_ip=%s/32\npublic_key=%x\nallowed_ip=10.0.0.3/32\n", serverKey, clientPub, clientAddr, [32]byte{3})))
+	require.NoError(t, peer.IpcSet(fmt.Sprintf("private_key=%x\npublic_key=%x\nallowed_ip=%s/32\nendpoint=127.0.0.1:4\n", clientKey, serverPub, serverAddr)))
+	require.NoError(t, server.Up())
+	require.NoError(t, peer.Up())
+
+	upload := tuntest.Ping(serverAddr, clientAddr)
+	wireGuardGateSend(t, clientTUN.Outbound, upload)
+	require.Equal(t, admission{"account", len(upload)}, wireGuardGateReceive(t, requests))
+	select {
+	case <-serverTUN.Inbound:
+		t.Fatal("upload was delivered before admission")
+	default:
+	}
+	grants <- struct{}{}
+	require.Equal(t, upload, wireGuardGateReceive(t, serverTUN.Inbound))
+
+	// An inner address configured for a different peer must never reach
+	// the gate even though this transport session itself authenticated.
+	wrongSource := tuntest.Ping(serverAddr, netip.MustParseAddr("10.0.0.3"))
+	wireGuardGateSend(t, clientTUN.Outbound, wrongSource)
+	wireGuardGateSend(t, clientTUN.Outbound, upload)
+	require.Equal(t, admission{"account", len(upload)}, wireGuardGateReceive(t, requests))
+	grants <- struct{}{}
+	require.Equal(t, upload, wireGuardGateReceive(t, serverTUN.Inbound))
+
+	down := tuntest.Ping(clientAddr, serverAddr)
+	wireGuardGateSend(t, serverTUN.Outbound, down)
+	require.Equal(t, admission{"account", len(down)}, wireGuardGateReceive(t, requests))
+	select {
+	case <-clientTUN.Inbound:
+		t.Fatal("download was delivered before admission")
+	default:
+	}
+	grants <- struct{}{}
+	require.Equal(t, down, wireGuardGateReceive(t, clientTUN.Inbound))
+}
+
+func TestWireGuardGateBlockedAccountDoesNotBlockOtherPacketLanes(t *testing.T) {
+	a, b := [32]byte{1}, [32]byte{2}
+	users := []*protocol.MemoryUser{wgTestUser("alice", a, "10.0.0.2/32"), wgTestUser("bob", b, "10.0.0.3/32")}
+	blocked := make(chan struct{}, 1)
+	gate := wgTestGate(func(ctx context.Context, id string, n int) error {
+		if id == "alice" && n == 32 {
+			blocked <- struct{}{}
+			<-ctx.Done()
+			return ctx.Err()
+		}
+		return nil
+	})
+	policy, err := newPacketGatePolicy(gate, [32]byte{9}, users, map[[32]byte]string{a: "alice", b: "bob"})
+	require.NoError(t, err)
+	stack := tuntest.NewChannelTUN()
+	wrapped := newPacketGateTun(stack.TUN(), policy)
+	t.Cleanup(func() { require.NoError(t, wrapped.Close()) })
+	serverAddr := netip.MustParseAddr("10.0.0.1")
+	alice := netip.MustParseAddr("10.0.0.2")
+	bob := netip.MustParseAddr("10.0.0.3")
+	alicePacket := tuntest.Ping(serverAddr, alice)
+	written, err := wrapped.Write([][]byte{alicePacket}, 0)
+	require.NoError(t, err)
+	require.Equal(t, 1, written)
+	wireGuardGateReceive(t, blocked)
+	for range 2 * packetsPerAccountDirection {
+		_, err := wrapped.Write([][]byte{alicePacket}, 0)
+		require.NoError(t, err)
+	}
+	require.Len(t, policy.clients["alice"].lane[packetUpload].slots, packetsPerAccountDirection)
+	bobPacket := tuntest.Ping(serverAddr, bob)
+	_, err = wrapped.Write([][]byte{bobPacket}, 0)
+	require.NoError(t, err)
+	require.Equal(t, bobPacket, wireGuardGateReceive(t, stack.Inbound))
+	aliceDownload := append(tuntest.Ping(alice, serverAddr), 0)
+	wireGuardGateSend(t, stack.Outbound, aliceDownload)
+	ready := make(chan []byte, 1)
+	go func() {
+		buffer := make([]byte, 1420)
+		sizes := make([]int, 1)
+		_, _ = wrapped.Read([][]byte{buffer}, sizes, 0)
+		ready <- buffer[:sizes[0]]
+	}()
+	require.Equal(t, aliceDownload, wireGuardGateReceive(t, ready))
+}
