--- /dev/null
+++ b/proxy/wireguard/packet_gate.go
@@ -0,0 +1,301 @@
+package wireguard
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net/netip"
+	"os"
+	"slices"
+	"sort"
+	"strconv"
+	"sync"
+
+	"github.com/xtls/xray-core/common/protocol"
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+type wireGuardPacketGate interface {
+	VanillaProxyWireGuardClients(context.Context, []*protocol.MemoryUser) (map[[32]byte]string, bool, error)
+	VanillaProxyWaitWireGuardPacket(context.Context, string, int) error
+	VanillaProxyMarkWireGuardFlow(context.Context) (context.Context, error)
+}
+
+func (*Server) VanillaProxyWireGuardPacketGateV1() {}
+
+func (s *Server) VanillaProxyWireGuardPacketGateEnabled() bool { return s.packetPolicy != nil }
+
+const (
+	packetsPerAccountDirection = 32
+	packetsPerTunnelDirection  = 1024
+)
+
+type packetGateLane struct {
+	queue chan []byte
+	slots chan struct{}
+}
+
+type packetGateClient struct {
+	id   string
+	lane [2]packetGateLane
+}
+
+type packetGateRoute struct {
+	prefix netip.Prefix
+	user   *protocol.MemoryUser
+	client *packetGateClient
+}
+
+type packetGatePolicy struct {
+	gate    wireGuardPacketGate
+	routes  []packetGateRoute
+	clients map[string]*packetGateClient
+}
+
+func newPacketGatePolicy(gate wireGuardPacketGate, serverKey [32]byte, users []*protocol.MemoryUser, clientIDs map[[32]byte]string) (*packetGatePolicy, error) {
+	policy := &packetGatePolicy{gate: gate, clients: make(map[string]*packetGateClient)}
+	keys := make(map[[32]byte]struct{}, len(users))
+	for _, user := range users {
+		peer := user.Account.(*MemoryAccount)
+		id := clientIDs[peer.Pub]
+		_, duplicate := keys[peer.Pub]
+		if id == "" || duplicate || peer.Pub == serverKey || peer.Pub == ([32]byte{}) || len(peer.AllowedIPs) == 0 {
+			return nil, fmt.Errorf("managed WireGuard peer %q requires a bound unique public key and AllowedIPs", user.Email)
+		}
+		keys[peer.Pub] = struct{}{}
+		// These fields are inserted into the WireGuard UAPI as single lines.
+		if peer.PreSharedKey != "" {
+			if _, err := ParseKey(peer.PreSharedKey); err != nil {
+				return nil, fmt.Errorf("invalid preshared key for managed WireGuard peer %q", user.Email)
+			}
+		}
+		if peer.KeepAlive != "" {
+			if _, err := strconv.ParseUint(peer.KeepAlive, 10, 16); err != nil {
+				return nil, fmt.Errorf("invalid keepalive for managed WireGuard peer %q", user.Email)
+			}
+		}
+		client := policy.clients[id]
+		if client == nil {
+			client = &packetGateClient{id: id}
+			policy.clients[id] = client
+		}
+		for _, prefix := range peer.AllowedIPs {
+			if !prefix.IsValid() || prefix.Addr().Is4In6() {
+				return nil, fmt.Errorf("invalid AllowedIP for managed WireGuard peer %q", user.Email)
+			}
+			policy.routes = append(policy.routes, packetGateRoute{prefix.Masked(), user, client})
+		}
+	}
+	if len(keys) != len(clientIDs) {
+		return nil, fmt.Errorf("managed WireGuard binding references an unconfigured peer")
+	}
+	slices.SortFunc(policy.routes, func(a, b packetGateRoute) int { return a.prefix.Addr().Compare(b.prefix.Addr()) })
+	for i := 1; i < len(policy.routes); i++ {
+		prev, next := policy.routes[i-1].prefix, policy.routes[i].prefix
+		if prev.Overlaps(next) {
+			return nil, fmt.Errorf("overlapping managed WireGuard AllowedIPs %s and %s", prev, next)
+		}
+	}
+	return policy, nil
+}
+
+func (p *packetGatePolicy) route(addr netip.Addr) *packetGateRoute {
+	i := sort.Search(len(p.routes), func(i int) bool { return p.routes[i].prefix.Addr().Compare(addr) > 0 })
+	if i != 0 && p.routes[i-1].prefix.Contains(addr) {
+		return &p.routes[i-1]
+	}
+	return nil
+}
+
+type packetGateDirection int
+
+const (
+	packetUpload packetGateDirection = iota
+	packetDownload
+)
+
+type admittedWireGuardPacket struct {
+	data []byte
+	lane *packetGateLane
+}
+
+// packetGateTun sits between WireGuard and Xray's stack. Only decrypted
+// packets that passed WireGuard's peer AllowedIPs check reach Write, and
+// downlink packets leave Read before WireGuard encrypts for the chosen peer.
+type packetGateTun struct {
+	tun.Device
+	policy *packetGatePolicy
+	ctx    context.Context
+	cancel context.CancelFunc
+	slots  [2]chan struct{}
+	ready  chan admittedWireGuardPacket
+
+	workers   sync.WaitGroup
+	enqueueMu sync.RWMutex
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func newPacketGateTun(base tun.Device, policy *packetGatePolicy) *packetGateTun {
+	ctx, cancel := context.WithCancel(context.Background())
+	t := &packetGateTun{Device: base, policy: policy, ctx: ctx, cancel: cancel, ready: make(chan admittedWireGuardPacket, packetsPerTunnelDirection)}
+	for direction := packetUpload; direction <= packetDownload; direction++ {
+		t.slots[direction] = make(chan struct{}, packetsPerTunnelDirection)
+		for _, client := range policy.clients {
+			lane := &client.lane[direction]
+			lane.queue = make(chan []byte, packetsPerAccountDirection)
+			lane.slots = make(chan struct{}, packetsPerAccountDirection)
+			t.workers.Go(func() { t.runLane(client.id, lane, direction) })
+		}
+	}
+	t.workers.Go(t.readDownlink)
+	return t
+}
+
+func wireGuardPacketAddress(packet []byte, direction packetGateDirection) netip.Addr {
+	if len(packet) == 0 || len(packet) > device.MaxContentSize {
+		return netip.Addr{}
+	}
+	switch packet[0] >> 4 {
+	case 4:
+		if len(packet) >= 20 {
+			start := 12 + 4*int(direction)
+			return netip.AddrFrom4([4]byte(packet[start : start+4]))
+		}
+	case 6:
+		if len(packet) >= 40 {
+			start := 8 + 16*int(direction)
+			addr := netip.AddrFrom16([16]byte(packet[start : start+16]))
+			if !addr.Is4In6() {
+				return addr
+			}
+		}
+	}
+	return netip.Addr{}
+}
+
+func (t *packetGateTun) enqueue(packet []byte, direction packetGateDirection) {
+	route := t.policy.route(wireGuardPacketAddress(packet, direction))
+	if route == nil {
+		return
+	}
+	t.enqueueMu.RLock()
+	defer t.enqueueMu.RUnlock()
+	if t.ctx.Err() != nil {
+		return
+	}
+	lane := &route.client.lane[direction]
+	select {
+	case lane.slots <- struct{}{}:
+	default:
+		return
+	}
+	select {
+	case t.slots[direction] <- struct{}{}:
+	default:
+		<-lane.slots
+		return
+	}
+	// WireGuard and the stack both reuse their input buffers. Each queued
+	// packet owns a slot until it is dropped or consumed by its destination.
+	lane.queue <- bytes.Clone(packet)
+}
+
+func (t *packetGateTun) release(lane *packetGateLane, direction packetGateDirection) {
+	<-t.slots[direction]
+	<-lane.slots
+}
+
+func (t *packetGateTun) runLane(clientID string, lane *packetGateLane, direction packetGateDirection) {
+	for t.ctx.Err() == nil {
+		select {
+		case <-t.ctx.Done():
+			return
+		case packet := <-lane.queue:
+			if t.ctx.Err() == nil && t.policy.gate.VanillaProxyWaitWireGuardPacket(t.ctx, clientID, len(packet)) == nil && t.ctx.Err() == nil {
+				if direction == packetDownload {
+					t.ready <- admittedWireGuardPacket{packet, lane}
+					continue
+				}
+				_, _ = t.Device.Write([][]byte{packet}, 0)
+			}
+			t.release(lane, direction)
+		}
+	}
+}
+
+func (t *packetGateTun) readDownlink() {
+	defer t.cancel()
+	// The native server TUN has BatchSize 1. Its stack writes plain IP.
+	buffer := make([]byte, device.MaxContentSize+1)
+	bufs := [][]byte{buffer}
+	sizes := []int{0}
+	for t.ctx.Err() == nil {
+		n, err := t.Device.Read(bufs, sizes, 0)
+		if err != nil {
+			return
+		}
+		if n != 0 {
+			t.enqueue(buffer[:sizes[0]], packetDownload)
+		}
+	}
+}
+
+func (t *packetGateTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	for t.ctx.Err() == nil {
+		select {
+		case <-t.ctx.Done():
+			return 0, os.ErrClosed
+		case packet := <-t.ready:
+			t.release(packet.lane, packetDownload)
+			if t.ctx.Err() == nil && len(packet.data) <= len(bufs[0])-offset {
+				sizes[0] = copy(bufs[0][offset:], packet.data)
+				return 1, nil
+			}
+		}
+	}
+	return 0, os.ErrClosed
+}
+
+func (t *packetGateTun) Write(bufs [][]byte, offset int) (int, error) {
+	if t.ctx.Err() != nil {
+		return 0, os.ErrClosed
+	}
+	for _, buffer := range bufs {
+		t.enqueue(buffer[offset:], packetUpload)
+	}
+	// Dropping a packet whose queue is full keeps other peers' cryptographic
+	// receivers and the shared TUN moving. IP transports handle packet loss.
+	return len(bufs), nil
+}
+
+func (t *packetGateTun) Close() error {
+	t.closeOnce.Do(func() {
+		t.cancel()
+		t.closeErr = t.Device.Close()
+		t.workers.Wait()
+		// No workers can publish data now. Exclude final concurrent enqueues
+		// so a closed server does not retain any queued packet buffers.
+		t.enqueueMu.Lock()
+		defer t.enqueueMu.Unlock()
+		for _, client := range t.policy.clients {
+			for direction := packetUpload; direction <= packetDownload; direction++ {
+				lane := &client.lane[direction]
+				for len(lane.queue) != 0 {
+					<-lane.queue
+					t.release(lane, direction)
+				}
+			}
+		}
+		for {
+			select {
+			case packet := <-t.ready:
+				t.release(packet.lane, packetDownload)
+			default:
+				return
+			}
+		}
+	})
+	return t.closeErr
+}
diff --git b/proxy/wireguard/packet_gate_test.go b/proxy/wireguard/packet_gate_test.go
